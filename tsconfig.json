{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		// TypeScript 6 no longer picks up @types/* by itself: the test globals.
		"types": ["jest"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
	"exclude": [
		"node_modules",
		"babel.config.js",
		"metro.config.js",
		"jest.config.js",
		"android",
		"ios",
		"scripts"
	]
}
