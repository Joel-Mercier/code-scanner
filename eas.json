{
	"cli": {
		"version": ">= 16.6.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"APP_VARIANT": "development"
			}
		},
		"preview": {
			"distribution": "internal",
			"android": {
				"buildType": "apk",
				"gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
			},
			"env": {
				"APP_VARIANT": "preview"
			}
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"APP_VARIANT": "production"
			}
		},
		"production-apk": {
			"extends": "production",
			"autoIncrement": false,
			"android": {
				"buildType": "apk",
				"gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
