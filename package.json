{
	"name": "code-scanner",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"packageManager": "bun@1.4.3",
	"engines": {
		"node": ">=26.12.0"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"typecheck": "bun check",
		"prebuild": "bunx expo prebuild --clean",
		"prebuild:development": "APP_VARIANT=development bun run prebuild",
		"prebuild:preview": "APP_VARIANT=preview bun run prebuild",
		"prebuild:production": "APP_VARIANT=production bun run prebuild",
		"build:android:development": "mkdir -p tmp && eas build -p android --profile development --local --output $PWD/tmp/code-scanner-dev-$npm_package_version.apk",
		"build:android:preview": "mkdir -p tmp && eas build -p android --profile preview --local --output $PWD/tmp/code-scanner-preview-$npm_package_version.apk",
		"build:android:production": "mkdir -p tmp && eas build -p android --profile production --local --output $PWD/tmp/code-scanner-$npm_package_version.aab",
		"build:android:production-apk": "mkdir -p tmp && eas build -p android --profile production-apk --local --output $PWD/tmp/code-scanner-$npm_package_version-arm64-v8a.apk",
		"submit:android:production": "eas submit -p android --profile production"
	},
	"dependencies": {
		"@expo-google-fonts/geist": "^0.4.2",
		"@expo-google-fonts/geist-mono": "^0.4.3",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@legendapp/list": "^3.9.1",
		"@paulmillr/qr": "^0.3.0",
		"@react-native-community/datetimepicker": "9.2.1",
		"@shopify/react-native-skia": "2.14.0",
		"bwip-js": "^4.11.4",
		"date-fns": "^4.4.0",
		"expo": "~58.0.23",
		"expo-application": "~58.1.2",
		"expo-build-properties": "~58.0.12",
		"expo-calendar": "~58.0.6",
		"expo-camera": "~58.0.14",
		"expo-clipboard": "~58.0.4",
		"expo-constants": "~58.0.15",
		"expo-contacts": "~58.0.10",
		"expo-dev-client": "~58.0.18",
		"expo-file-system": "~58.0.13",
		"expo-font": "~58.0.11",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.18",
		"expo-image-picker": "~58.0.10",
		"expo-linking": "~58.0.16",
		"expo-localization": "~58.0.5",
		"expo-media-library": "~58.0.13",
		"expo-navigation-bar": "~58.0.4",
		"expo-router": "~58.0.30",
		"expo-splash-screen": "~58.0.13",
		"expo-status-bar": "~58.0.4",
		"expo-system-ui": "~58.0.7",
		"expo-web-browser": "~58.0.7",
		"i18next": "^26.7.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-i18next": "^17.1.13",
		"react-native": "0.88.1",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-keyboard-controller": "1.22.7",
		"react-native-mmkv": "^4.3.2",
		"react-native-nitro-modules": "^0.37.2",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-share": "^12.3.1",
		"react-native-svg": "15.16.0",
		"react-native-web": "^0.21.4",
		"react-native-worklets": "0.13.0",
		"reanimated-color-picker": "5.1.3",
		"zod": "4.6.7",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@biomejs/biome": "2.6.6",
		"@types/react": "~19.3.0",
		"eas-cli": "^27.5.0",
		"eslint": "^9.25.0",
		"eslint-config-expo": "~58.0.4",
		"expo-atlas": "^0.5.0",
		"typescript": "~6.0.3"
	},
	"private": true,
	"patchedDependencies": {
		"zod@4.6.7": "patches/zod@4.6.7.patch"
	}
}
